# Local development points at a MongoDB on this machine.
# In production (Vercel) set these in the project's Environment Variables and
# use a MongoDB Atlas connection string - a serverless function cannot reach a
# database running on your laptop.
MONGODB_URI=mongodb://127.0.0.1:27017/linguaroute

# Only used by the local server; Vercel assigns the port itself.
PORT=4000

# Comma-separated list of origins allowed to call this API from a browser.
# Leave blank locally. In production set it to the deployed client URL, e.g.
# CORS_ORIGIN=https://linguaroute.vercel.app
CORS_ORIGIN=
